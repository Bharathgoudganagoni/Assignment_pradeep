# ==============================================================================
# ENECTRON ENQUIRY MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure with your actual credentials.
# NEVER commit .env containing real secrets to version control!
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000

# Frontend URL (Allowed CORS Origins for development)
# In production on Render, frontend and backend run together on the same origin.
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5000

# ==============================================================================
# Option A: Google Apps Script HTTPS Webhook (RECOMMENDED FOR RENDER FREE TIER)
# Render Free Tier blocks outbound SMTP ports 25, 465, and 587.
# Google Apps Script operates over standard HTTPS (Port 443) and sends emails
# directly from your Gmail account without blocked ports.
# See backend/google-apps-script.js for the 2-minute setup instructions.
# ==============================================================================
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec
GOOGLE_SCRIPT_SECRET=enectron_secure_relay_2026

# ==============================================================================
# Option B: Nodemailer SMTP Configuration (For local testing or unblocked hosts)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM="ENECTRON Enquiries" <your_email@gmail.com>

# ==============================================================================
# Fixed Destination Emails (Configured strictly on backend)
# ==============================================================================
RECEIVER_EMAIL=receiver@enectron.com
OWNER_EMAIL=receiver@enectron.com
BUILDER_EMAIL=
SEND_CUSTOMER_ACK=false
