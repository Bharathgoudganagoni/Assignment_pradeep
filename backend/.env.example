# ==============================================================================
# ENECTRON FULL-STACK ENQUIRY MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure with your actual database & SMTP credentials.
# NEVER commit .env containing real secrets to version control!
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000

# Frontend URL (Allowed CORS Origin)
# For local development: http://localhost:3000, http://127.0.0.1:5500, etc.
# For production: https://your-frontend-site.onrender.com
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5000

# ==============================================================================
# MySQL Database Configuration
# Compatible with local MySQL, Aiven, PlanetScale, TiDB Cloud, Clever Cloud, etc.
# ==============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=enectron_db
# Set DB_SSL=true or DB_SSL=require for cloud managed databases that require TLS/SSL (e.g. Aiven, Render external DB)
DB_SSL=false
# Optional: Database connection pool limits
DB_CONNECTION_LIMIT=10

# ==============================================================================
# Nodemailer SMTP Email Configuration
# Works with Gmail App Passwords, Outlook, Zoho, SendGrid, Brevo, Mailgun, Amazon SES, etc.
# Note: Render Free tier blocks outbound port 25, 465, 587 on some plans;
# For Render, use port 587 (TLS) or port 465 (SSL) with authenticated SMTP services like Brevo/SendGrid/Gmail.
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set SMTP_SECURE=true for port 465; set SMTP_SECURE=false for port 587 / STARTTLS
SMTP_SECURE=false
SMTP_USER=your_smtp_user_or_email@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="ENECTRON Enquiries" <your_smtp_user_or_email@gmail.com>

# ==============================================================================
# Notification Recipients (Configurable & Reusable for any company)
# ==============================================================================
# Primary recipient who receives the new customer enquiries
OWNER_EMAIL=owner@enectron.com

# Optional: Developer / site builder who receives a monitoring copy
BUILDER_EMAIL=builder@enectron.com

# Optional: Send automated confirmation acknowledgement to the enquiry customer (true/false)
SEND_CUSTOMER_ACK=true
