# ==============================================================================
# ENECTRON FULL-STACK ENQUIRY MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure with your actual SMTP credentials.
# NEVER commit .env containing real secrets to version control!
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000

# Frontend URL (Allowed CORS Origins for development)
# In production on Render, frontend and backend run as a single service on the same origin.
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5000

# ==============================================================================
# Nodemailer SMTP Email Configuration (Gmail SMTP)
# For Gmail, create a 16-character App Password under your Google Account Security settings.
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM="ENECTRON Enquiries" <your_email@gmail.com>

# ==============================================================================
# Fixed Receiver Email (All website enquiries are delivered here)
# ==============================================================================
RECEIVER_EMAIL=receiver@enectron.com
OWNER_EMAIL=receiver@enectron.com
BUILDER_EMAIL=
SEND_CUSTOMER_ACK=false
